# App
APP_ENV=local
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg2://aisnab:aisnab@database:5432/aisnab

# MinIO (S3)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_FILES=aisnab-files
MINIO_BUCKET_TEMPLATES=aisnab-templates

# Redis (future tasks / caching)
REDIS_URL=redis://redis:6379/0

# LLM (Ollama on host; inside docker this usually maps to host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434
MODEL_CHAT=qwen2.5:7b-instruct
